# Copy to .env to override. Every value here is a fake, local-only test value.
# docker compose reads .env automatically; without it, the defaults in
# docker-compose.yml (the same values as below) are used.

# Local n8n owner account, created on first start by the n8n-setup service.
# Used to log in to the editor at http://localhost:15678 and by `npm run screenshots`.
N8N_OWNER_EMAIL=owner@example.test
N8N_OWNER_PASSWORD=Demo-owner-pass-1
N8N_ENCRYPTION_KEY=local-demo-encryption-key-not-secret

# Mock catalog API credentials. The mocks and the workflow read the same values.
HARBOR_API_KEY=harbor-demo-key
SUMMIT_CLIENT_ID=summit-demo-client
SUMMIT_CLIENT_SECRET=summit-demo-secret
MEADOW_API_KEY=meadow-demo-key

# LLM: any OpenAI-compatible chat completions endpoint.
# Default is the local mock in mocks/llm.js. To use a real provider, set for example:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=<your key>
#   LLM_MODEL=<a chat model your provider offers>
LLM_BASE_URL=http://mock-llm:15674/v1
LLM_API_KEY=mock-llm-key
LLM_MODEL=mock-catalog-llm
